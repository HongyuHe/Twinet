# Build artifacts
/bin/
/dist/
*.test
*.out

# Lab runtime state
/labs/*/state/
*.twinetlab

# Local overrides
.env
*.local.yaml

# Injected-fault records carry ground truth and must never be committed.
.twinet/

# Credentials and host keys generated for a lab. These are secrets by
# definition and a repository is the last place they belong.
**/.twinet/roster.json
**/.twinet/credentials.txt
**/.twinet/gateway_host_key

# Binaries staged into an image build context. They are build outputs, not
# sources, and the image build copies them in from bin/.
images/*/twinet-rtr
